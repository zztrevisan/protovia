# Cada instalação deve usar banco e credenciais próprios.
HOST=127.0.0.1
PORT=3000
SQLITE_DATABASE_PATH=banco/protovia.db
# Gere um segredo longo antes de abrir a instalação inicial.
SETUP_TOKEN=
# URL pública desta instalação, usada nos e-mails.
APP_URL=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
# Apenas para start:cloud / Vercel, em banco vazio e separado.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
